/* ============ 页面容器 ============ */
.page {
  width: 100%;
  height: 100vh;
  background: radial-gradient(ellipse at 50% 45%, #1a2050 0%, #0a0e2e 45%, #050714 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ============ 太阳系区域 ============ */
.solar-system {
  flex: 1;
  position: relative;
  width: 100%;
  overflow: hidden;
}

/* ============ CSS 椭圆底环（始终可见） ============ */
.orbit-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.025);
  pointer-events: none;
  z-index: 1;
}

/* ============ 已走过轨道：纯 CSS 半圆裁剪进度弧 ============ */
.arc-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
  pointer-events: none;
  z-index: 3;
}
.arc-half {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  overflow: hidden;
}
.arc-right { right: 0; }
.arc-left { left: 0; }
.arc-semi {
  position: absolute;
  top: 0;
  width: 200%;
  height: 100%;
  box-sizing: border-box;
  border: 4rpx solid transparent;
  border-radius: 50%;
}
/* 右半环：上+右 两条边上色，拼成从 12 点经 3 点到 6 点的 180° 弧 */
.arc-right .arc-semi {
  left: -100%;
  border-top-color: rgba(255, 208, 125, 0.5);
  border-right-color: rgba(255, 208, 125, 0.5);
}
/* 左半环：下+左 两条边上色，拼成从 6 点经 9 点到 12 点的 180° 弧 */
.arc-left .arc-semi {
  left: 0;
  border-bottom-color: rgba(255, 208, 125, 0.5);
  border-left-color: rgba(255, 208, 125, 0.5);
}

/* ============ 右上角音效按钮 ============ */
.sound-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 30;
}
.sound-btn.on {
  background: rgba(255, 210, 130, 0.14);
  border-color: rgba(255, 210, 130, 0.35);
}
.sound-btn.off {
  opacity: 0.45;
}
/* 喇叭箱体 */
.speaker {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}
.speaker-box {
  position: absolute;
  left: 0;
  top: 7rpx;
  width: 8rpx;
  height: 10rpx;
  background: #ffd97a;
  border-radius: 2rpx 0 0 2rpx;
}
.speaker-cone {
  position: absolute;
  left: 6rpx;
  top: 3rpx;
  width: 0;
  height: 0;
  border-top: 9rpx solid transparent;
  border-bottom: 9rpx solid transparent;
  border-right: 12rpx solid #ffd97a;
}
/* 声波 */
.wave {
  position: absolute;
  border: 2rpx solid transparent;
  border-top-color: #ffd97a;
  border-radius: 50%;
}
.wave-a {
  width: 16rpx;
  height: 16rpx;
  right: 16rpx;
  top: 28rpx;
}
.wave-b {
  width: 26rpx;
  height: 26rpx;
  right: 11rpx;
  top: 23rpx;
}
/* 静音斜杠 */
.mute-bar {
  position: absolute;
  width: 44rpx;
  height: 3rpx;
  background: rgba(255, 255, 255, 0.65);
  border-radius: 2rpx;
  transform: rotate(-45deg);
}

/* ============ 星空 ============ */
.stars {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}
.star {
  position: absolute;
  background: #fff;
  border-radius: 50%;
}
.twinkle {
  animation: twinkle 3s ease-in-out infinite;
}
@keyframes twinkle {
  0%, 100% { opacity: 0.15; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* ============ 太阳 ============ */
.sun-wrapper {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 120rpx;
  height: 120rpx;
  transform: translate(-50%, -50%);
  z-index: 20;
}
.sun-body {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #fff8e0, #ffd83a 35%, #ff9c1a 70%, #e8550c);
  box-shadow: 0 0 36rpx #ffaa00, 0 0 80rpx rgba(255, 140, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.sun-glow {
  position: absolute;
  top: -50rpx;
  left: -50rpx;
  width: calc(100% + 100rpx);
  height: calc(100% + 100rpx);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 200, 60, 0.28), transparent 65%);
  pointer-events: none;
}
.sun-corona {
  position: absolute;
  top: -110rpx;
  left: -110rpx;
  width: calc(100% + 220rpx);
  height: calc(100% + 220rpx);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 170, 0, 0.12), transparent 55%);
  pointer-events: none;
}

/* 太阳计时数字（在太阳上） */
.sun-time-on-sun {
  font-size: 24rpx;
  color: #4a1f00;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-shadow: 0 0 6rpx rgba(255, 240, 180, 0.9);
  white-space: nowrap;
}

/* 太阳状态 */
.sun-body.sun-idle { opacity: 0.55; filter: saturate(0.6); }
.sun-glow.sun-idle { opacity: 0.3; }
.sun-body.sun-running { animation: sun-pulse 4s ease-in-out infinite; }
.sun-glow.sun-running { animation: sun-pulse 4s ease-in-out infinite; }
.sun-body.sun-paused { opacity: 0.75; }
.sun-glow.sun-paused { opacity: 0.5; }
@keyframes sun-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

/* 太阳点击热区 */
.sun-tap {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  z-index: 22;
}

/* 太阳下方提示 */
.sun-hint-below {
  position: absolute;
  top: calc(100% + 10rpx);
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.3);
  white-space: nowrap;
  pointer-events: none;
  letter-spacing: 2rpx;
}
.sun-hint-below.sun-running { color: rgba(255, 220, 120, 0.5); }

/* ============ 轨道定位锚点 ============ */
.orbit-point {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  z-index: 10;
}

/* ============ 行星点击区 ============ */
.planet-hit {
  position: absolute;
  top: 0;
  left: 0;
  transform: translate(-50%, -50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ============ 行星本体 ============ */
.planet {
  border-radius: 50%;
  position: relative;
  box-shadow: inset -4rpx -4rpx 8rpx rgba(0, 0, 0, 0.4);
  transition: box-shadow 0.3s;
}

.planet-mercury  { background: radial-gradient(circle at 30% 30%, #d8d0c8, #8a8278 55%, #4a4238); }
.planet-venus    { background: radial-gradient(circle at 30% 30%, #fce0a8, #d4a85e 55%, #8c6828); }
.planet-earth    { background: radial-gradient(circle at 30% 30%, #8ed0ff, #2d7fc8 45%, #155088 75%, #0d2d5c); }
.planet-mars     { background: radial-gradient(circle at 30% 30%, #ffa888, #d4582a 55%, #7c2810); }
.planet-jupiter  { background: repeating-linear-gradient(0deg, rgba(120,70,30,0.25) 0rpx, rgba(120,70,30,0.25) 5rpx, transparent 5rpx, transparent 11rpx), radial-gradient(circle at 30% 30%, #f4dab0, #d4a373 55%, #946838); }
.planet-saturn   { background: radial-gradient(circle at 30% 30%, #f4e0b8, #d4b878 55%, #988838); }
.planet-uranus   { background: radial-gradient(circle at 30% 30%, #c0f4f2, #7fdbda 50%, #2a8b8a); }
.planet-neptune  { background: radial-gradient(circle at 30% 30%, #8ab0ff, #3a5ed9 55%, #1a3a8e); }

/* 土星环 */
.saturn-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 72rpx;
  height: 20rpx;
  border: 2rpx solid rgba(220, 200, 150, 0.55);
  border-radius: 50%;
  transform: translate(-50%, -50%) rotate(-22deg);
  pointer-events: none;
}

/* 运行时光晕 */
.planet-trail {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 130%;
  height: 130%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.3), transparent 60%);
  transform: translate(-50%, -50%);
  opacity: 0;
  transition: opacity 0.4s;
  pointer-events: none;
}
.planet-trail.show { opacity: 1; }

.planet.state-running { box-shadow: inset -4rpx -4rpx 8rpx rgba(0,0,0,0.4), 0 0 14rpx 2rpx rgba(255,255,255,0.2); }
.planet.state-paused { opacity: 0.55; filter: saturate(0.6); }

.planet.just-completed { animation: complete-flash 0.6s ease-out; }
@keyframes complete-flash {
  0% { box-shadow: 0 0 30rpx 8rpx rgba(255, 230, 120, 0.9); }
  100% { box-shadow: inset -4rpx -4rpx 8rpx rgba(0,0,0,0.4); }
}

/* ============ 行星倒计时结束：爆炸 + 持续燃烧 ============ */
/* 燃烧中的火球：放大脉动 + 持续声呐光环，直至重置 */
.planet.state-done {
  background: radial-gradient(circle at 40% 40%, #fff6d8, #ffb347 30%, #ff6a00 60%, #b3220e 85%, #6b1408);
  box-shadow: 0 0 30rpx 10rpx rgba(255, 130, 40, 0.9), 0 0 80rpx 26rpx rgba(255, 80, 0, 0.45), inset -4rpx -6rpx 10rpx rgba(60, 0, 0, 0.5);
  animation: burn-flicker 0.9s ease-in-out infinite;
  opacity: 1;
  filter: none;
}
@keyframes burn-flicker {
  0%, 100% { transform: scale(1.25); box-shadow: 0 0 26rpx 8rpx rgba(255, 130, 40, 0.85), 0 0 70rpx 22rpx rgba(255, 80, 0, 0.4), inset -4rpx -6rpx 10rpx rgba(60, 0, 0, 0.5); }
  50% { transform: scale(1.55); box-shadow: 0 0 44rpx 14rpx rgba(255, 160, 60, 1), 0 0 100rpx 32rpx rgba(255, 100, 0, 0.55), inset -4rpx -6rpx 10rpx rgba(60, 0, 0, 0.5); }
}
/* 燃烧声呐环：围绕火球持续外扩 */
.planet.state-done::after {
  content: '';
  position: absolute;
  top: -34rpx;
  left: -34rpx;
  right: -34rpx;
  bottom: -34rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 150, 60, 0.8);
  animation: burn-wave 1.4s ease-out infinite;
}
@keyframes burn-wave {
  0% { opacity: 0.9; transform: scale(0.55); }
  100% { opacity: 0; transform: scale(1.8); }
}

/* 爆炸覆盖层（以行星为中心的 0x0 锚点，子元素绝对定位展开） */
.boom-layer {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  pointer-events: none;
  z-index: 15;
}
/* 白色闪光：大幅放大淡出 */
.boom-flash {
  position: absolute;
  top: -170rpx;
  left: -170rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 240, 0.95), rgba(255, 200, 90, 0.5) 40%, transparent 70%);
  animation: boom-flash 0.9s ease-out forwards;
}
@keyframes boom-flash {
  0% { opacity: 1; transform: scale(0.3); }
  60% { opacity: 0.85; }
  100% { opacity: 0; transform: scale(2); }
}
/* 双层冲击波光环 */
.boom-ring {
  position: absolute;
  top: -40rpx;
  left: -40rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 170, 80, 0.85);
  animation: boom-ring 1.2s ease-out forwards;
}
.boom-ring-2 { animation-delay: 0.22s; }
@keyframes boom-ring {
  0% { opacity: 0.95; transform: scale(0.4); }
  100% { opacity: 0; transform: scale(6); }
}
/* 八向火星：旋转坐标系 + 径向飞出 */
.boom-spark {
  position: absolute;
  top: 0;
  left: 0;
  width: 0;
  height: 0;
}
.spark-dot {
  position: absolute;
  top: -5rpx;
  left: -5rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ffcc66;
  box-shadow: 0 0 10rpx rgba(255, 160, 60, 0.95);
  animation: spark-fly 1.1s ease-out forwards;
}
@keyframes spark-fly {
  0% { opacity: 1; transform: translateY(0) scale(1); }
  70% { opacity: 0.9; }
  100% { opacity: 0; transform: translateY(-230rpx) scale(0.35); }
}

/* ============ 底部状态面板 ============ */
.status-panel {
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(8, 10, 30, 0.88);
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.status-hint { text-align: center; font-size: 22rpx; color: rgba(255,255,255,0.35); margin-bottom: 14rpx; letter-spacing: 3rpx; }
.status-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.status-item { width: 24%; display: flex; align-items: center; margin-bottom: 10rpx; padding: 8rpx 6rpx; border-radius: 12rpx; background: rgba(255,255,255,0.025); transition: background 0.3s; }
.status-item.st-running { background: rgba(255,200,80,0.1); box-shadow: 0 0 0 1rpx rgba(255,200,80,0.2); }
.status-item.st-paused { background: rgba(130,170,255,0.1); box-shadow: 0 0 0 1rpx rgba(130,170,255,0.25); }
.status-item.completed { background: rgba(120,255,180,0.12); }
/* 燃烧中（done）状态，优先于 completed 绿色 */
.status-item.st-done { background: rgba(255, 110, 40, 0.14); box-shadow: 0 0 0 1rpx rgba(255, 120, 50, 0.4); }
.status-item.st-done .status-time { color: #ff9a5c; }
.status-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 8rpx; flex-shrink: 0; }
.status-dot.planet-mercury  { background: radial-gradient(circle at 30% 30%, #d8d0c8, #4a4238); }
.status-dot.planet-venus    { background: radial-gradient(circle at 30% 30%, #fce0a8, #8c6828); }
.status-dot.planet-earth    { background: radial-gradient(circle at 30% 30%, #8ed0ff, #0d2d5c); }
.status-dot.planet-mars     { background: radial-gradient(circle at 30% 30%, #ffa888, #7c2810); }
.status-dot.planet-jupiter  { background: radial-gradient(circle at 30% 30%, #f4dab0, #946838); }
.status-dot.planet-saturn   { background: radial-gradient(circle at 30% 30%, #f4e0b8, #988838); }
.status-dot.planet-uranus   { background: radial-gradient(circle at 30% 30%, #c0f4f2, #2a8b8a); }
.status-dot.planet-neptune  { background: radial-gradient(circle at 30% 30%, #8ab0ff, #1a3a8e); }
.status-text { display: flex; flex-direction: column; }
.status-name { font-size: 20rpx; color: rgba(255,255,255,0.6); line-height: 1.3; }
.status-time { font-size: 20rpx; color: rgba(255,255,255,0.85); font-weight: 600; line-height: 1.3; }
.status-item.st-running .status-time { color: #ffd97a; }
.status-item.st-paused .status-time { color: #9db8ff; }
